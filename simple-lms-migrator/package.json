{
    "name": "simple-lms-migrator",
    "version": "1.0.0",
    "description": "One-time data migration tooling for SimpleLMS Bridge. Deactivate and delete after go-live.",
    "author": "One Dog Solutions",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build:css": "tailwindcss -i ./src/admin/tailwind.css -o ./build/admin/tailwind.css --minify",
        "build:js": "wp-scripts build src/admin/index.js --output-path=build/admin",
        "build": "npm run build:js && npm run build:css",
        "start:css": "tailwindcss -i ./src/admin/tailwind.css -o ./build/admin/tailwind.css --watch",
        "start:js": "wp-scripts start src/admin/index.js --output-path=build/admin",
        "start": "npm run start:css & npm run start:js",
        "lint:js": "wp-scripts lint-js src/",
        "lint:css": "wp-scripts lint-style src/"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.0",
        "@wordpress/scripts": "^30.0.0",
        "tailwindcss": "^4.2.0"
    },
    "dependencies": {
        "@wordpress/api-fetch": "^7.0.0",
        "@wordpress/components": "^28.0.0",
        "@wordpress/element": "^6.0.0",
        "@wordpress/i18n": "^5.0.0"
    }
}
